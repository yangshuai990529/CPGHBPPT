{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-ppt-agent.local/schemas/project.schema.json",
  "title": "Product PPT Project Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "topic", "purpose", "audience", "available_materials", "constraints"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^proj-[a-z0-9-]+$"},
    "topic": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decision_needed": {"type": ["string", "null"]},
    "available_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "type", "uri", "status"],
        "properties": {
          "material_id": {"type": "string"},
          "type": {"enum": ["pptx", "pdf", "docx", "xlsx", "image", "url", "text", "dataset", "none"]},
          "uri": {"type": ["string", "null"]},
          "status": {"enum": ["provided", "available", "missing", "not_applicable"]},
          "role": {"type": ["string", "null"]}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generate_pptx"],
      "properties": {
        "generate_pptx": {"type": "boolean"},
        "language": {"type": "string"},
        "max_slides": {"type": ["integer", "null"], "minimum": 1},
        "research_mode": {"enum": ["none", "provided_materials_only", "internal", "external"]},
        "template_id": {"type": ["string", "null"]}
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}}
  }
}
