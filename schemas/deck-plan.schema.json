{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-ppt-agent.local/schemas/deck-plan.schema.json",
  "title": "Product PPT Deck Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deck_id",
    "deck_title",
    "objective",
    "audience",
    "core_message",
    "storyline",
    "slides",
    "open_questions"
  ],
  "properties": {
    "deck_id": {
      "type": "string",
      "pattern": "^deck-[a-z0-9-]+$"
    },
    "deck_title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "core_message": {
      "type": "string",
      "minLength": 1
    },
    "storyline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "role",
          "question",
          "answer"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "context",
              "evidence",
              "diagnosis",
              "bridge",
              "choice",
              "definition",
              "execution",
              "measurement",
              "navigation"
            ]
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slidePlan"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "renderer_entry_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockers"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "blocked",
            "ready"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "slidePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_id",
        "sequence",
        "section_id",
        "purpose",
        "question",
        "key_message",
        "evidence_needed",
        "analysis_method",
        "visualization_candidate",
        "dependencies"
      ],
      "properties": {
        "slide_id": {
          "type": "string",
          "pattern": "^s[0-9]{2,3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "section_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "key_message": {
          "type": "string",
          "minLength": 1
        },
        "evidence_needed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analysis_method": {
          "type": "string",
          "minLength": 1
        },
        "visualization_candidate": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "visual_requirement": {
          "type": "object",
          "properties": {
            "priority": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "usage": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
